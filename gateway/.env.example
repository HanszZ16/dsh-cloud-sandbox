# Copy to .env; run.sh loads it on every start. See README "配置项" for every option.

# Encrypts users' saved API keys. Set once and keep it: changing it makes saved keys unreadable.
GATEWAY_SECRET_KEY=change-me
# Creates this administrator on startup when no enabled administrator exists.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=

# Team-shared DeepSeek key; optional when every user sets their own key in the portal.
DEEPSEEK_API_KEY=

GATEWAY_PUBLIC_URL=http://localhost:8000
SANDBOX_BACKEND=docker
SANDBOX_DOCKER_IMAGE=dsh-sandbox:dev
# Egress proxy for sandboxes (plugin and npm installs), e.g. http://host.docker.internal:7897
SANDBOX_HTTP_PROXY=
