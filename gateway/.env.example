# Copy to .env; run.sh loads it on every start. See README "配置项" for every option.

# Encrypts users' saved API keys. Set once and keep it: changing it makes saved keys unreadable.
GATEWAY_SECRET_KEY=change-me
# Creates this administrator on startup when no enabled administrator exists.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=

# Team-shared DeepSeek key; optional when every user sets their own key in the portal.
DEEPSEEK_API_KEY=

GATEWAY_PUBLIC_URL=http://localhost:8000
# docker, opensandbox (see opensandbox.example.toml), or e2b
SANDBOX_BACKEND=docker
SANDBOX_DOCKER_IMAGE=dsh-sandbox:dev
# Docker backend OCI runtime: runsc for gVisor (see the README's gVisor section); empty uses runc
SANDBOX_DOCKER_RUNTIME=
# OpenSandbox backend: server address and API key; FILES_DIR must be in the server's allowed_host_paths
OPENSANDBOX_URL=http://127.0.0.1:8090
OPENSANDBOX_API_KEY=
OPENSANDBOX_FILES_DIR=sandbox-files
# Keep each user's /home/agent in an OpenSandbox volume (1) or archive it to home.tar (0)
OPENSANDBOX_HOME_VOLUMES=1
# Egress proxy for sandboxes (plugin and npm installs), e.g. http://host.docker.internal:7897
SANDBOX_HTTP_PROXY=
# Knowledge base uploads: largest file and the total a user's documents may hold, in MB
KB_MAX_FILE_MB=50
KB_QUOTA_MB=500
# Files panel uploads into a workspace: largest file, in MB
UPLOAD_MAX_MB=200

# Optional. Requires a separate HTTPS hostname and Chromium on the gateway.
# See ../docs/website-login.zh.md before enabling.
WEBSITE_LOGIN_ORIGIN=
# Optional site aliases and explicit form selectors. Leave blank for standard public HTTPS login pages.
WEBSITE_LOGIN_SITES_FILE=
WEBSITE_LOGIN_VAULT_KEY=
