{
  "name": "dsh-cloud-rag-kb",
  "version": "1.0.2",
  "description": "Knowledge base for dsh-cloud workspaces: upload and manage documents in a side panel; the agent answers from them through hybrid vector and keyword search with citations. Forked from @puwenhui/dsh-rag-kb 0.3.1.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@huggingface/transformers": "3.8.1",
    "mammoth": "1.13.0",
    "unpdf": "0.12.2"
  }
}
